---
import EmptyState from '../../components/EmptyState.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
  buildActivityDetails,
  buildActivityGallery,
  loadSheetsData,
  publicSheetsData,
} from '../../data';
import { CATEGORY_LABELS, formatDate } from '../../data/format';
import BaseLayout from '../../layouts/BaseLayout.astro';

const loadedSheets = await loadSheetsData();
loadedSheets.warnings.forEach((warning) => console.warn(`[Google Sheets] ${warning}`));
const data = publicSheetsData(loadedSheets.data);
const activities = buildActivityDetails(data).sort((a, b) => {
  const aDate = a.actualDate ?? a.plannedDate ?? '9999-12-31';
  const bDate = b.actualDate ?? b.plannedDate ?? '9999-12-31';
  return aDate.localeCompare(bDate) || a.title.localeCompare(b.title, 'id');
});
const gallery = buildActivityGallery(activities);
const tags = [...new Set(gallery.flatMap((image) => image.tags))].sort((a, b) =>
  a.localeCompare(b, 'id'),
);
const filterGroups = [
  {
    key: 'kelompok',
    label: 'Kelompok',
    options: data.groups.map(({ id, village }) => ({
      value: id,
      label: `${id.toUpperCase()} · ${village.replace(/^Desa\s+/i, '')}`,
    })),
  },
  {
    key: 'kategori',
    label: 'Jenis program',
    options: Object.entries(CATEGORY_LABELS).map(([value, label]) => ({ value, label })),
  },
  ...(tags.length
    ? [
        {
          key: 'tag',
          label: 'Tag',
          options: tags.map((tag) => ({ value: tag, label: tag })),
        },
      ]
    : []),
];
---

<BaseLayout
  title="Galeri"
  description="Galeri seluruh gambar yang digunakan pada artikel kegiatan aktif KKN Kecamatan Pancalang."
>
  <section class="page-intro">
    <div class="page-intro__inner container">
      <p class="eyebrow">Cerita dalam gambar</p>
      <h1>Suasana, proses, dan perjumpaan dari lapangan.</h1>
      <p class="page-intro__description">
        Perbesar foto untuk melihat caption, lalu buka artikel sumber untuk memahami cerita
        lengkap di baliknya.
      </p>
      <p class="page-intro__meta">
        <strong>{gallery.length} foto</strong>
        <span aria-hidden="true">·</span>
        <span>Diturunkan langsung dari artikel kegiatan aktif</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" data-filter-root>
      {
        gallery.length ? (
          <>
            <FilterBar
              groups={filterGroups}
              resultLabel="foto"
              searchPlaceholder="Cari kegiatan, caption, atau tag"
            />
            <div class="gallery-grid">
              {gallery.map((image, index) => (
                <figure
                  class:list={[index % 5 === 0 && 'gallery-card--tall']}
                  data-filter-item
                  data-filter-search={[
                    image.activityTitle,
                    image.caption,
                    image.alt,
                    image.tags.join(' '),
                    image.groupId,
                    image.category,
                  ].join(' ')}
                  data-filter-kelompok={image.groupId}
                  data-filter-kategori={image.category}
                  data-filter-tag={image.tags.join('|')}
                >
                  <button
                    type="button"
                    class="gallery-card__image-link"
                    aria-label={`Perbesar foto dari ${image.activityTitle}`}
                    data-gallery-open
                    data-gallery-src={image.src}
                    data-gallery-alt={image.alt}
                    data-gallery-caption-text={image.caption}
                    data-gallery-href={image.activityHref}
                  >
                    <img
                      src={image.src}
                      alt={image.alt}
                      width="1200"
                      height={index % 5 === 0 ? '1600' : '900'}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <figcaption>
                    <div class="gallery-card__meta">
                      <span>{image.groupId.toUpperCase()}</span>
                      <span>{CATEGORY_LABELS[image.category]}</span>
                      {image.date && <time datetime={image.date}>{formatDate(image.date)}</time>}
                    </div>
                    <h2><a href={image.activityHref}>{image.activityTitle}</a></h2>
                    <p>{image.caption}</p>
                    {
                      image.tags.length > 0 && (
                        <ul aria-label="Tag kegiatan">
                          {image.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                      )
                    }
                    <a href={image.activityHref}>Lihat cerita kegiatan →</a>
                  </figcaption>
                </figure>
              ))}
            </div>
            <dialog class="gallery-dialog" data-gallery-dialog aria-label="Pratinjau foto kegiatan">
              <div class="gallery-dialog__toolbar">
                <p data-gallery-position></p>
                <button type="button" data-gallery-close aria-label="Tutup pratinjau">×</button>
              </div>
              <img src="/default.png" alt="" width="1400" height="1000" data-gallery-image />
              <div class="gallery-dialog__caption">
                <p data-gallery-dialog-caption></p>
                <a href="/kegiatan" data-gallery-source>Lihat cerita kegiatan</a>
              </div>
              <div class="gallery-dialog__navigation">
                <button type="button" data-gallery-previous>← Foto sebelumnya</button>
                <button type="button" data-gallery-next>Foto berikutnya →</button>
              </div>
            </dialog>
            <div hidden data-filter-empty class="filtered-empty">
              <EmptyState
                title="Belum ada foto untuk filter ini"
                description="Coba pilih kelompok, jenis program, atau tag yang lain."
              />
            </div>
          </>
        ) : (
          <EmptyState
            title="Galeri kegiatan belum tersedia"
            description="Belum ada foto terverifikasi yang dirender pada artikel kegiatan aktif."
          />
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const initialiseGalleryPage = () => {
    document.querySelectorAll<HTMLElement>('[data-filter-root]').forEach((root) => {
      if (root.dataset.galleryPageReady === 'true') return;
      const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
      const image = root.querySelector<HTMLImageElement>('[data-gallery-image]');
      const caption = root.querySelector<HTMLElement>('[data-gallery-dialog-caption]');
      const source = root.querySelector<HTMLAnchorElement>('[data-gallery-source]');
      const position = root.querySelector<HTMLElement>('[data-gallery-position]');
      const close = root.querySelector<HTMLButtonElement>('[data-gallery-close]');
      const previous = root.querySelector<HTMLButtonElement>('[data-gallery-previous]');
      const next = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
      const triggers = [...root.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
      if (!dialog || !image || !caption || !source || !position || !close || !previous || !next) {
        return;
      }

      root.dataset.galleryPageReady = 'true';
      let activeIndex = 0;
      const showImage = (requestedIndex: number) => {
        activeIndex = (requestedIndex + triggers.length) % triggers.length;
        const trigger = triggers[activeIndex];
        image.src = trigger.dataset.gallerySrc ?? '/default.png';
        image.alt = trigger.dataset.galleryAlt ?? '';
        caption.textContent =
          trigger.dataset.galleryCaptionText ?? trigger.dataset.galleryAlt ?? '';
        source.href = trigger.dataset.galleryHref ?? '/kegiatan';
        position.textContent = `${activeIndex + 1} dari ${triggers.length}`;
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => {
          showImage(index);
          dialog.showModal();
        });
      });
      close.addEventListener('click', () => dialog.close());
      previous.addEventListener('click', () => showImage(activeIndex - 1));
      next.addEventListener('click', () => showImage(activeIndex + 1));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') showImage(activeIndex - 1);
        if (event.key === 'ArrowRight') showImage(activeIndex + 1);
      });
    });
  };

  initialiseGalleryPage();
  document.addEventListener('astro:page-load', initialiseGalleryPage);
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  figure {
    display: grid;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .gallery-card__image-link {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--color-surface-soft);
    cursor: zoom-in;
  }

  figure img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--color-surface-soft);
    transition: transform var(--transition-fast);
  }

  .gallery-card__image-link:hover img {
    transform: scale(1.025);
  }

  figcaption {
    display: grid;
    padding: var(--space-3);
    align-content: start;
    gap: var(--space-2);
  }

  .gallery-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--font-size-base);
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-link);
  }

  figcaption > p {
    display: none;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  ul {
    display: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
  }

  li {
    padding: 0.14rem 0.45rem;
    border-radius: var(--radius-pill);
    color: var(--color-link);
    background: var(--color-primary-soft);
    font-size: 0.65rem;
    font-weight: 700;
  }

  figcaption > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-link);
    font-size: var(--font-size-xs);
    font-weight: 800;
  }

  .filtered-empty {
    margin-top: var(--space-6);
  }

  .gallery-dialog {
    width: min(94vw, 64rem);
    max-height: 94vh;
    padding: var(--space-4);
    border: 0;
    border-radius: var(--radius-lg);
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: 0 24px 80px rgb(30 42 48 / 34%);
  }

  .gallery-dialog::backdrop {
    background: rgb(30 42 48 / 76%);
    backdrop-filter: blur(5px);
  }

  .gallery-dialog__toolbar,
  .gallery-dialog__navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .gallery-dialog__toolbar {
    margin-bottom: var(--space-3);
  }

  .gallery-dialog__toolbar p {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gallery-dialog__toolbar button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-dark);
    background: var(--color-surface);
    font-size: 1.5rem;
    cursor: pointer;
  }

  .gallery-dialog > img {
    width: 100%;
    max-height: 68vh;
    border-radius: var(--radius-md);
    object-fit: contain;
    background: var(--color-surface-soft);
  }

  .gallery-dialog__caption {
    display: grid;
    padding-block: var(--space-4);
    gap: var(--space-2);
  }

  .gallery-dialog__caption p {
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .gallery-dialog__caption a {
    width: fit-content;
    color: var(--color-link);
    font-size: var(--font-size-sm);
    font-weight: 800;
  }

  .gallery-dialog__navigation {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .gallery-dialog__navigation button {
    min-height: 2.75rem;
    padding-inline: 0;
    border: 0;
    color: var(--color-link);
    background: transparent;
    font-size: var(--font-size-sm);
    font-weight: 800;
    cursor: pointer;
  }

  @media (min-width: 40rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }

    figcaption {
      padding: var(--space-4);
    }

    .gallery-dialog__caption {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    h2 {
      font-size: var(--font-size-lg);
    }

    figcaption > p,
    ul {
      display: flex;
    }

    figcaption > p {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .gallery-grid {
      grid-auto-flow: dense;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .gallery-card--tall {
      grid-row: span 2;
    }

    .gallery-card--tall .gallery-card__image-link,
    .gallery-card--tall img {
      height: 100%;
      min-height: 28rem;
    }
  }
</style>
