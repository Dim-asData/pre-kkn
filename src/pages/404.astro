---
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak ditemukan di Jejak KKN Pancalang."
  noindex
>
  <section class="section not-found">
    <div class="container not-found__content">
      <p class="eyebrow">404 · Alamat tidak ditemukan</p>
      <h1>Halaman yang Anda cari tidak tersedia.</h1>
      <p class="not-found__description">
        Alamatnya mungkin berubah atau sudah tidak digunakan. Kembali ke beranda atau lanjutkan
        menjelajahi dokumentasi kegiatan.
      </p>
      <div class="not-found__actions">
        <PrimaryButton href="/">Kembali ke beranda</PrimaryButton>
        <SecondaryButton href="/kegiatan">Lihat kegiatan</SecondaryButton>
        <SecondaryButton href="/umkm">Cari UMKM</SecondaryButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: 62vh;
    overflow: hidden;
    align-items: center;
    background:
      radial-gradient(circle at 82% 26%, rgb(124 185 232 / 22%), transparent 18rem),
      radial-gradient(circle at 12% 90%, rgb(232 154 183 / 9%), transparent 18rem);
  }

  .not-found::after {
    position: absolute;
    width: 18rem;
    height: 15rem;
    border: 1px solid rgb(85 107 47 / 14%);
    border-radius: 44% 56% 38% 62% / 54% 44% 56% 46%;
    content: '';
    inset: auto -8rem -8rem auto;
  }

  .not-found__content {
    display: grid;
    max-width: 48rem;
    justify-items: start;
    gap: var(--space-4);
  }

  h1 {
    max-width: 15ch;
    font-size: var(--font-size-3xl);
  }

  .not-found__description {
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
