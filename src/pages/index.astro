---
import ActivityCard from '../components/ActivityCard.astro';
import EmptyState from '../components/EmptyState.astro';
import GroupCard from '../components/GroupCard.astro';
import HeroSection from '../components/HeroSection.astro';
import ImageGallery from '../components/ImageGallery.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import TextLink from '../components/TextLink.astro';
import UMKMCard from '../components/UMKMCard.astro';
import {
  buildActivityDetails,
  buildActivityGallery,
  loadSheetsData,
  publicSheetsData,
} from '../data';
import BaseLayout from '../layouts/BaseLayout.astro';

const loadedSheets = await loadSheetsData();
const data = publicSheetsData(loadedSheets.data);
loadedSheets.warnings.forEach((warning) => console.warn(`[Google Sheets] ${warning}`));

const activities = buildActivityDetails(data).sort((a, b) => {
  const aDate = a.actualDate ?? a.plannedDate ?? '9999-12-31';
  const bDate = b.actualDate ?? b.plannedDate ?? '9999-12-31';
  return aDate.localeCompare(bDate) || a.title.localeCompare(b.title, 'id');
});
const featuredActivities = activities.slice(0, 3);
const featuredUmkm = data.umkm
  .filter(
    (item, index, entries) =>
      entries.findIndex((candidate) => candidate.groupId === item.groupId) === index,
  )
  .slice(0, 3);
const galleryImages = buildActivityGallery(activities)
  .slice(0, 6)
  .map((image) => ({
    src: image.src,
    alt: image.alt,
    caption: image.caption,
    href: image.activityHref,
  }));
const verifiedOutputs = activities
  .flatMap(({ outputs }) => outputs)
  .filter(({ verificationStatus }) => verificationStatus === 'verified');
const activeProgress = activities.filter(({ status }) =>
  ['ongoing', 'completed'].includes(status),
).length;
---

<BaseLayout>
  <HeroSection
    eyebrow="KKN Budi Luhur University · Kecamatan Pancalang"
    title="Cerita pengabdian yang dekat dengan warga."
    description="Dokumentasi kegiatan mahasiswa dan ruang untuk mengenal produk lokal dari Sumbakeling, Silebu, serta Pancalang—disusun jujur, hangat, dan mudah ditelusuri."
    primaryAction={{ href: '/kegiatan', label: 'Lihat kegiatan terbaru' }}
    secondaryAction={{ href: '/umkm', label: 'Cari produk UMKM' }}
  />

  <section class="section village-section" id="desa">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <h2>Tiga desa, cerita yang tumbuh dengan cara berbeda.</h2>
        </div>
        <p>
          Pilih desa untuk langsung melihat kegiatan yang relevan. Kode kelompok tetap ditampilkan
          sebagai informasi pendukung.
        </p>
      </div>
      {
        data.groups.length ? (
          <div class="overview-grid overview-grid--three">
            {data.groups.map((group) => (
              <GroupCard
                group={group}
                activityCount={activities.filter(({ groupId }) => groupId === group.id).length}
                umkmCount={data.umkm.filter(({ groupId }) => groupId === group.id).length}
                educationCount={
                  activities.filter(
                    ({ groupId, category }) => groupId === group.id && category === 'education',
                  ).length
                }
              />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Ringkasan desa belum dapat dimuat"
            description="Data wilayah sedang tidak tersedia. Daftar kegiatan dan UMKM tetap dapat dijelajahi melalui navigasi utama."
          />
        )
      }
    </div>
  </section>

  <section class="section latest-section">
    <div class="container">
      <div class="section-heading section-heading--with-link">
        <div>
          <h2>Lihat apa yang sedang direncanakan dan dikerjakan.</h2>
          <p>
            Status, tanggal, lokasi, dan bukti ditampilkan apa adanya agar rencana tidak terbaca
            sebagai realisasi.
          </p>
        </div>
        <TextLink href="/kegiatan">Lihat semua kegiatan</TextLink>
      </div>
      {
        featuredActivities.length ? (
          <div class="overview-grid overview-grid--three">
            {featuredActivities.map((activity, index) => (
              <ActivityCard activity={activity} eager={index === 0} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Artikel kegiatan belum tersedia"
            description="Belum ada artikel kegiatan aktif yang dapat ditampilkan."
          >
            <SecondaryButton href="/kegiatan">Buka daftar kegiatan</SecondaryButton>
          </EmptyState>
        )
      }
    </div>
  </section>

  <section class="section umkm-section">
    <div class="container umkm-feature">
      <div class="umkm-feature__intro">
        <p class="eyebrow">Belanja lebih dekat</p>
        <h2>Kenali produk dan usaha dari desa setempat.</h2>
        <p>
          Profil usaha memprioritaskan produk, cara pemesanan, jam buka, dan lokasi. Kontak hanya
          ditampilkan setelah aman untuk dipublikasikan.
        </p>
        <PrimaryButton href="/umkm">Temukan produk UMKM</PrimaryButton>
      </div>
      {
        featuredUmkm.length ? (
          <div class="overview-grid overview-grid--three umkm-feature__grid">
            {featuredUmkm.map((item) => (
              <UMKMCard
                item={item}
                group={data.groups.find(({ id }) => id === item.groupId)}
              />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Profil UMKM belum dapat ditampilkan"
            description="Hanya data yang aktif dan telah diperiksa yang muncul di direktori publik."
          />
        )
      }
    </div>
  </section>

  <section class="section impact-section">
    <div class="container impact-shell">
      <div class="impact-copy">
        <h2>Angka ringkas dengan konteks yang tetap terjaga.</h2>
      </div>
      <dl class="impact-grid">
        <div>
          <dt>Program aktif</dt>
          <dd>{activities.length}</dd>
        </div>
        <div>
          <dt>Program selesai</dt>
          <dd>{activeProgress}</dd>
        </div>
        <div>
          <dt>Output tercatat</dt>
          <dd>{verifiedOutputs.length}</dd>
        </div>
        <div>
          <dt>UMKM publik</dt>
          <dd>{data.umkm.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container">
      {
        galleryImages.length ? (
          <>
            <div class="section-heading section-heading--with-link">
              <div>
                <h2>Potongan suasana dari lapangan.</h2>
                <p>Setiap foto kembali ke artikel kegiatan sumber agar konteksnya tidak terlepas.</p>
              </div>
              <TextLink href="/galeri">Buka galeri lengkap</TextLink>
            </div>
            <ImageGallery images={galleryImages} showHeading={false} />
          </>
        ) : (
          <EmptyState
            title="Galeri kegiatan belum tersedia"
            description="Foto akan muncul setelah gambar terverifikasi ditambahkan ke artikel kegiatan."
          />
        )
      }
    </div>
  </section>

</BaseLayout>

<style>
  .village-section,
  .gallery-section {
    background: rgb(255 255 255 / 46%);
  }

  .latest-section {
    position: relative;
  }

  .latest-section::before {
    position: absolute;
    z-index: -1;
    width: 16rem;
    height: 16rem;
    border-radius: 50%;
    background: rgb(232 154 183 / 7%);
    content: '';
    inset: 18% auto auto -9rem;
  }

  .section-heading--split,
  .section-heading--with-link {
    max-width: none;
  }

  .section-heading--split > div,
  .section-heading--with-link > div {
    display: grid;
    max-width: 46rem;
    gap: var(--space-2);
  }

  .section-heading--split > p {
    max-width: 36rem;
    color: var(--color-text-muted);
  }

  .umkm-section {
    overflow: hidden;
    background:
      radial-gradient(circle at 8% 15%, rgb(124 185 232 / 22%), transparent 19rem),
      radial-gradient(circle at 94% 92%, rgb(85 107 47 / 10%), transparent 20rem),
      var(--color-primary-soft);
  }

  .umkm-feature {
    display: grid;
    gap: var(--space-7);
  }

  .umkm-feature__intro {
    display: grid;
    max-width: 37rem;
    align-content: start;
    justify-items: start;
    gap: var(--space-4);
  }

  .umkm-feature__intro h2 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .umkm-feature__intro > p:not(.eyebrow) {
    color: var(--color-text-muted);
  }

  .impact-section {
    color: rgb(255 255 255 / 72%);
    background:
      radial-gradient(circle at 88% 20%, rgb(124 185 232 / 15%), transparent 21rem),
      var(--color-dark);
  }

  .impact-shell {
    display: grid;
    gap: var(--space-7);
  }

  .impact-copy {
    display: grid;
    max-width: 40rem;
    gap: var(--space-3);
  }

  .impact-copy .eyebrow {
    color: #a8d7f5;
  }

  .impact-copy h2 {
    color: var(--color-surface);
    font-size: var(--font-size-2xl);
  }

  .impact-grid {
    display: grid;
    margin: 0;
    gap: var(--space-3);
  }

  .impact-grid div {
    display: grid;
    padding: var(--space-4);
    gap: var(--space-1);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 6%);
  }

  .impact-grid dt,
  .impact-grid span {
    color: rgb(255 255 255 / 58%);
    font-size: var(--font-size-xs);
  }

  .impact-grid dt {
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .impact-grid dd {
    margin: 0;
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .transparency-section {
    padding-top: 0;
  }

  .transparency-card {
    display: grid;
    padding: clamp(var(--space-5), 6vw, var(--space-7));
    align-items: center;
    gap: var(--space-5);
    border: 1px solid rgb(85 107 47 / 20%);
    border-radius: var(--radius-lg);
    background: var(--color-t3-soft);
  }

  .transparency-card__icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 50%;
    color: var(--color-t3-dark);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .transparency-card__icon svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .transparency-card > div:nth-child(2) {
    display: grid;
    max-width: 42rem;
    gap: var(--space-2);
  }

  .transparency-card h2 {
    font-size: var(--font-size-xl);
  }

  .transparency-card p:not(.eyebrow) {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .section-heading--split,
    .section-heading--with-link {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, auto);
      align-items: end;
    }

    .impact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .transparency-card {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 72rem) {
    .umkm-feature {
      grid-template-columns: minmax(18rem, 0.4fr) minmax(0, 1.6fr);
      align-items: start;
    }

    .umkm-feature__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .impact-shell {
      grid-template-columns: minmax(18rem, 0.6fr) minmax(0, 1.4fr);
      align-items: end;
    }
  }
</style>
