---
import type { GroupData, UmkmData } from '../data/types';
import { photoUrl } from '../lib/photos';
import GroupBadge from './GroupBadge.astro';
import TextLink from './TextLink.astro';

interface Props {
  item: UmkmData;
  group?: GroupData;
  eager?: boolean;
}

const { item, group, eager = false } = Astro.props;
const href = `/umkm/${item.groupId}/${item.slug}`;
const hasContact = Boolean(item.whatsapp);
---

<article class="umkm-card">
  <a class="umkm-card__image-link" href={href} aria-label={`Lihat ${item.name}`}>
    <img
      src={photoUrl(item.heroPhoto)}
      alt={item.heroPhoto ? `Foto profil ${item.name}` : `[DUMMY] Placeholder foto profil ${item.name}`}
      width="1200"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="umkm-card__category">{item.category}</span>
  </a>
  <div class="umkm-card__body">
    <div class="umkm-card__badges">
      <GroupBadge kelompok={item.groupId} showName />
      <span class:list={['umkm-card__contact', hasContact && 'is-available']}>
        <span aria-hidden="true"></span>
        {hasContact ? 'Kontak tersedia' : 'Profil usaha'}
      </span>
    </div>
    <div>
      <p class="umkm-card__village">{group?.village ?? item.groupId.toUpperCase()}</p>
      <h3><a href={href}>{item.name}</a></h3>
    </div>
    <p>{item.shortDescription}</p>
    <ul aria-label="Bentuk pendampingan">
      {item.assistance.slice(0, 3).map((label) => <li>{label}</li>)}
    </ul>
    <TextLink href={href}>Lihat produk dan profil</TextLink>
  </div>
</article>

<style>
  .umkm-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 8px 28px rgb(30 42 48 / 7%);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .umkm-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .umkm-card__image-link {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-soft);
  }

  .umkm-card__category {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.34rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: var(--radius-pill);
    color: var(--color-surface);
    background: rgb(30 42 48 / 74%);
    font-size: 0.66rem;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--transition-fast);
  }

  .umkm-card:hover img {
    transform: scale(1.025);
  }

  .umkm-card__body {
    display: grid;
    padding: var(--space-5);
    align-content: start;
    gap: var(--space-3);
  }

  .umkm-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .umkm-card__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 750;
  }

  .umkm-card__contact > span {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: var(--color-text-muted);
  }

  .umkm-card__contact.is-available {
    color: var(--color-success);
  }

  .umkm-card__contact.is-available > span {
    background: var(--color-success);
  }

  .umkm-card__village {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }

  h3 {
    margin-top: var(--space-1);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    line-height: 1.25;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-link);
  }

  .umkm-card__body > p {
    color: var(--color-text-muted);
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  li {
    padding: 0.22rem 0.62rem;
    border-radius: var(--radius-pill);
    color: var(--color-link);
    background: var(--color-primary-soft);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }
</style>
