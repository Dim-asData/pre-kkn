---
interface Props {
  number?: string | null;
  label?: string;
}

const { number, label = 'Pesan via WhatsApp' } = Astro.props;
const href = number ? `https://wa.me/${number}` : null;
---

{
  href ? (
    <a class="whatsapp-button" href={href} target="_blank" rel="noreferrer">
      <span aria-hidden="true">WA</span>
      {label}
    </a>
  ) : (
    <p class="contact-unavailable">
      <span aria-hidden="true">i</span>
      Kontak pemesanan belum dipublikasikan. Lihat produk dan lokasi usaha terlebih dahulu.
    </p>
  )
}

<style>
  .whatsapp-button {
    display: inline-flex;
    min-height: 2.75rem;
    width: fit-content;
    padding: 0.62rem 1rem;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid #267a4a;
    border-radius: var(--radius-pill);
    color: #1f633c;
    background: #e9f7ee;
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-decoration: none;
  }

  .whatsapp-button > span {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: #267a4a;
    font-size: 0.62rem;
  }

  .contact-unavailable {
    display: flex;
    max-width: 32rem;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    align-items: flex-start;
    gap: var(--space-2);
    border-left: 3px solid var(--color-primary-dark);
    color: var(--color-text-muted);
    background: var(--color-primary-soft);
    font-size: var(--font-size-sm);
  }

  .contact-unavailable > span {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.12rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: var(--color-surface);
    background: var(--color-link);
    font-size: 0.7rem;
    font-weight: 800;
  }
</style>
