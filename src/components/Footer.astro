---
const year = new Date().getFullYear();
const navigation = [
  { label: 'Kegiatan', href: '/kegiatan' },
  { label: 'UMKM binaan', href: '/umkm' },
  { label: 'Galeri', href: '/galeri' },
];

const villages = [
  { group: 'T1', name: 'Sumbakeling', href: '/kegiatan?kelompok=t1', tone: 't1' },
  { group: 'T2', name: 'Silebu', href: '/kegiatan?kelompok=t2', tone: 't2' },
  { group: 'T3', name: 'Pancalang', href: '/kegiatan?kelompok=t3', tone: 't3' },
];
---

<footer class="site-footer">

  <div class="footer-inner container">
    <div class="footer-intro">
      <a class="footer-brand" href="/" aria-label="Jejak KKN Pancalang, beranda">
        <span aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <strong>Jejak KKN Pancalang</strong>
      </a>
      <p>
        Arsip publik kegiatan mahasiswa dan usaha lokal di desa
      </p>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="footer-label">Jelajahi</p>
      <ul>
        {navigation.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Kegiatan berdasarkan desa">
      <p class="footer-label">Tiga desa</p>
      <ul class="village-list">
        {
          villages.map(({ group, name, href, tone }) => (
            <li>
              <a href={href}>
                <span class:list={['dot', `dot--${tone}`]}></span>
                <span><small>{group}</small>{name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>© {year} KKN Budi Luhur University, Kecamatan Pancalang.</p>
    <p>Diperbarui dari data kegiatan yang telah diperiksa.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-7);
    color: rgb(255 255 255 / 72%);
    background:
      radial-gradient(circle at 8% 92%, rgb(124 185 232 / 13%), transparent 24rem),
      radial-gradient(circle at 92% 8%, rgb(85 107 47 / 20%), transparent 22rem),
      var(--color-dark);
  }

  .footer-cta {
    display: grid;
    margin-bottom: var(--space-8);
    padding: clamp(var(--space-5), 6vw, var(--space-7));
    align-items: center;
    gap: var(--space-5);
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 6%);
  }

  .footer-cta > div:first-child {
    display: grid;
    max-width: 44rem;
    gap: var(--space-2);
  }

  .footer-kicker,
  .footer-label {
    color: #a8d7f5;
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-cta h2 {
    color: var(--color-surface);
    font-size: var(--font-size-2xl);
  }

  .footer-cta__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-cta__links a {
    display: inline-flex;
    min-height: 2.875rem;
    padding-inline: var(--space-4);
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: var(--radius-pill);
    color: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-decoration: none;
  }

  .footer-cta__links .footer-cta__primary {
    border-color: var(--color-primary);
    color: var(--color-dark);
    background: var(--color-primary);
  }

  .footer-inner {
    display: grid;
    padding-bottom: var(--space-7);
    gap: var(--space-7);
  }

  .footer-intro {
    display: grid;
    max-width: 35rem;
    align-content: start;
    gap: var(--space-4);
  }

  .footer-brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    text-decoration: none;
  }

  .footer-brand > span {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 48% 52% 45% 55% / 56% 46% 54% 44%;
    background: rgb(124 185 232 / 18%);
    transform: rotate(-5deg);
  }

  .footer-brand i {
    position: absolute;
    width: 0.58rem;
    height: 0.58rem;
    border: 2px solid var(--color-dark);
    border-radius: 50%;
  }

  .footer-brand i:nth-child(1) {
    top: 0.62rem;
    left: 0.62rem;
    background: var(--color-t1);
  }

  .footer-brand i:nth-child(2) {
    top: 0.62rem;
    right: 0.54rem;
    background: #bd657b;
  }

  .footer-brand i:nth-child(3) {
    bottom: 0.48rem;
    left: 0.96rem;
    background: #9aae77;
  }

  .footer-trust {
    padding-left: var(--space-3);
    border-left: 2px solid rgb(124 185 232 / 55%);
    color: rgb(255 255 255 / 58%);
    font-size: var(--font-size-sm);
  }

  nav {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: rgb(255 255 255 / 76%);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-surface);
    text-decoration: underline;
  }

  .village-list a {
    gap: var(--space-3);
  }

  .village-list a > span:last-child {
    display: grid;
    line-height: 1.2;
  }

  .village-list small {
    color: rgb(255 255 255 / 48%);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .dot--t1 {
    background: var(--color-t1);
  }

  .dot--t2 {
    background: #bd657b;
  }

  .dot--t3 {
    background: #9aae77;
  }

  .footer-bottom {
    display: grid;
    padding-block: var(--space-5);
    gap: var(--space-2);
    border-top: 1px solid rgb(255 255 255 / 12%);
    color: rgb(255 255 255 / 52%);
    font-size: var(--font-size-xs);
  }

  @media (min-width: 48rem) {
    .footer-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .footer-cta__links {
      justify-content: flex-end;
    }

    .footer-inner {
      grid-template-columns: minmax(0, 1.8fr) repeat(2, minmax(10rem, 0.6fr));
    }

    .footer-bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
