---
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';

interface Action {
  href: string;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryAction?: Action;
  secondaryAction?: Action;
}

const { eyebrow, title, description, primaryAction, secondaryAction } = Astro.props;
---

<section class="hero-section">
  <div class="hero-section__inner container">
    <div class="hero-section__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-section__description">{description}</p>
      {
        (primaryAction || secondaryAction) && (
          <div class="hero-section__actions">
            {primaryAction && (
              <PrimaryButton href={primaryAction.href}>{primaryAction.label}</PrimaryButton>
            )}
            {secondaryAction && (
              <SecondaryButton href={secondaryAction.href}>{secondaryAction.label}</SecondaryButton>
            )}
          </div>
        )
      }
    </div>

    <div class="hero-section__visual" aria-label="Kolase dokumentasi KKN">
      <figure class="hero-photo hero-photo--main">
        <img
          src="/pre/images-1.jpg"
          alt="Mahasiswa KKN bersama warga dan perangkat setempat"
          width="800"
          height="600"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <figure class="hero-photo hero-photo--top">
        <img
          src="/pre/images-2.jpg"
          alt="Kelompok mahasiswa KKN bersama tokoh masyarakat"
          width="600"
          height="800"
          decoding="async"
        />
      </figure>
      <figure class="hero-photo hero-photo--bottom">
        <img
          src="/pre/images-3.jpg"
          alt="Pendampingan mahasiswa KKN kepada anak di desa"
          width="600"
          height="600"
          decoding="async"
        />
      </figure>
      <img
        class="hero-leaf hero-leaf--one"
        src="/leaf-1-transparent.png"
        alt=""
        width="1254"
        height="1254"
        decoding="async"
      />
      <img
        class="hero-leaf hero-leaf--two"
        src="/leaf-2-transparent.png"
        alt=""
        width="1254"
        height="1254"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-7), 8vw, 7rem);
    background:
      radial-gradient(circle at 6% 12%, rgb(124 185 232 / 18%), transparent 22rem),
      linear-gradient(180deg, rgb(255 255 255 / 42%), transparent 78%);
  }

  .hero-section::before,
  .hero-section::after {
    position: absolute;
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .hero-section::before {
    width: 22rem;
    height: 22rem;
    border: 1px solid rgb(232 154 183 / 18%);
    inset: -14rem auto auto -12rem;
  }

  .hero-section::after {
    width: 30rem;
    height: 30rem;
    border: 1px solid rgb(85 107 47 / 12%);
    inset: auto -20rem -18rem auto;
  }

  .hero-section__inner {
    display: grid;
    align-items: center;
    gap: var(--space-8);
  }

  .hero-section__copy {
    position: relative;
    z-index: 2;
    display: grid;
    max-width: 44rem;
    justify-items: start;
    gap: var(--space-5);
  }

  h1 {
    max-width: 13ch;
    font-size: var(--font-size-4xl);
    letter-spacing: -0.052em;
  }

  .hero-section__description {
    max-width: 39rem;
    color: #53616a;
    font-size: var(--font-size-lg);
  }

  .hero-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-section__facts {
    display: grid;
    width: 100%;
    margin: var(--space-2) 0 0;
    padding-top: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .hero-section__facts div {
    display: grid;
    min-width: 0;
    gap: var(--space-1);
  }

  .hero-section__facts dt {
    color: var(--color-text-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-section__facts dd {
    margin: 0;
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: clamp(0.9rem, 2vw, 1.08rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .hero-section__visual {
    position: relative;
    min-height: 28rem;
    isolation: isolate;
  }

  .hero-section__visual::before {
    position: absolute;
    z-index: -3;
    width: 80%;
    height: 86%;
    border-radius: 48% 52% 39% 61% / 56% 41% 59% 44%;
    background:
      radial-gradient(circle at 34% 30%, rgb(255 255 255 / 76%), transparent 28%),
      var(--color-primary-soft);
    content: '';
    inset: 5% 8% auto auto;
    transform: rotate(4deg);
  }

  .hero-photo {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 0.4rem solid var(--color-surface);
    background: var(--color-surface-soft);
    box-shadow: var(--shadow-lg);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo--main {
    z-index: 1;
    width: 76%;
    height: 72%;
    border-radius: 40% 60% 48% 52% / 56% 42% 58% 44%;
    inset: 12% auto auto 2%;
    transform: rotate(-2deg);
  }

  .hero-photo--main figcaption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    max-width: 12rem;
    padding: 0.46rem 0.72rem;
    border: 1px solid rgb(255 255 255 / 46%);
    border-radius: var(--radius-pill);
    color: var(--color-surface);
    background: rgb(30 42 48 / 78%);
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1.35;
    backdrop-filter: blur(8px);
  }

  .hero-photo--top {
    z-index: 2;
    width: 38%;
    height: 35%;
    border-radius: 44% 56% 45% 55% / 54% 42% 58% 46%;
    inset: 0 0 auto auto;
    transform: rotate(4.5deg);
  }

  .hero-photo--bottom {
    z-index: 3;
    width: 36%;
    height: 34%;
    border-radius: 48% 52% 39% 61% / 46% 58% 42% 54%;
    inset: auto 2% 1% auto;
    transform: rotate(-5deg);
  }

  .hero-stamp {
    position: absolute;
    z-index: 4;
    display: grid;
    width: 4.8rem;
    height: 4.8rem;
    place-items: center;
    border: 1px solid rgb(122 38 58 / 22%);
    border-radius: 50%;
    color: var(--color-t2);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
    inset: auto auto 3% 8%;
    transform: rotate(8deg);
  }

  .hero-leaf {
    position: absolute;
    z-index: -1;
    width: clamp(4rem, 12vw, 7rem);
    opacity: 0.76;
    filter: drop-shadow(0 0.45rem 0.7rem rgb(85 107 47 / 14%));
    pointer-events: none;
  }

  .hero-leaf--one {
    top: 0;
    left: -1%;
    transform: rotate(-28deg);
  }

  .hero-leaf--two {
    z-index: 0;
    top: 42%;
    right: 3%;
    bottom: auto;
    width: clamp(3.6rem, 10vw, 6rem);
    transform: rotate(28deg);
  }

  @media (max-width: 35rem) {
    .hero-section__copy {
      gap: var(--space-4);
    }

    .hero-section__actions {
      display: grid;
      width: 100%;
    }

    .hero-section__actions :global(.button) {
      width: 100%;
    }

    .hero-section__facts {
      gap: var(--space-2);
    }

    .hero-section__visual {
      min-height: 24rem;
    }
  }

  @media (min-width: 64rem) {
    .hero-section__inner {
      grid-template-columns: minmax(0, 1.02fr) minmax(27rem, 0.98fr);
    }

    .hero-section__visual {
      min-height: 34rem;
    }
  }
</style>
