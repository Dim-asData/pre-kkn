---
import type { GroupData, ProductData, UmkmData } from '../data/types';
import { splitMultilineParagraphs } from '../data';
import { photoUrl } from '../lib/photos';
import AidSummary from '../components/AidSummary.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GroupBadge from '../components/GroupBadge.astro';
import ImageGallery from '../components/ImageGallery.astro';
import InfoBox from '../components/InfoBox.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ProductCard from '../components/ProductCard.astro';
import QRCodeCard from '../components/QRCodeCard.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  item: UmkmData;
  group?: GroupData;
  products: ProductData[];
  related: UmkmData[];
}

const { item, group, products, related } = Astro.props;
const storyParagraphs = splitMultilineParagraphs(item.story);
const uniquenessParagraphs = splitMultilineParagraphs(item.uniqueness);
const impactParagraphs = splitMultilineParagraphs(item.assistanceImpact);
const isDummyProfile =
  [item.name, item.owner, item.tagline, item.shortDescription, item.address]
    .filter(Boolean)
    .some((value) => value?.includes('[DUMMY]')) ||
  item.heroPhoto?.includes('placehold.co') ||
  products.some(
    (product) =>
      [product.name, product.description].some((value) => value?.includes('[DUMMY]')) ||
      product.photo?.includes('placehold.co'),
  );
const galleryImages = [
  ...(item.heroPhoto
    ? [
        {
          src: photoUrl(item.heroPhoto),
          alt: `Foto utama ${item.name}`,
          caption: `Profil ${item.name}`,
        },
      ]
    : []),
  ...products.flatMap((product) =>
    product.photo
      ? [
          {
            src: photoUrl(product.photo),
            alt: `Foto ${product.name}`,
            caption: product.description ?? product.name,
          },
        ]
      : [],
  ),
];
const hasLocation = Boolean(item.address || item.mapsEmbed);
---

<BaseLayout title={item.name} description={item.shortDescription}>
  <header class="profile-header">
    <div class="container">
      <Breadcrumb
        items={[
          { label: 'Beranda', href: '/' },
          { label: 'UMKM', href: '/umkm' },
          { label: item.name },
        ]}
      />

      <div class="profile-header__grid">
        <div class="profile-header__copy">
          <div class="profile-header__badges">
            <GroupBadge kelompok={item.groupId} showName />
            <span>{item.category}</span>
          </div>
          <p class="eyebrow">Produk lokal{isDummyProfile ? ' [DUMMY]' : ''}</p>
          <h1>{item.name}</h1>
          {item.tagline && <p class="profile-header__tagline">{item.tagline}</p>}
          <p class="profile-header__description">{item.shortDescription}</p>
          <div class="profile-header__actions">
            <WhatsAppButton number={item.whatsapp} />
            {hasLocation && (
              <a class="profile-header__location-action" href="#lokasi">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 17s5-4.5 5-9a5 5 0 1 0-10 0c0 4.5 5 9 5 9Z"></path>
                  <circle cx="10" cy="8" r="1.6"></circle>
                </svg>
                Lihat lokasi
              </a>
            )}
            <ShareButton title={item.name} />
          </div>
        </div>

        <figure class="profile-header__media">
          <img
            src={photoUrl(item.heroPhoto)}
            alt={
              item.heroPhoto
                ? `Foto utama ${item.name}`
                : `[DUMMY] Placeholder foto utama ${item.name}`
            }
            width="1200"
            height="900"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>

      <dl class="profile-header__facts">
        <div>
          <dt>Pemilik</dt>
          <dd>{item.owner ?? 'Belum dicantumkan'}</dd>
        </div>
        <div>
          <dt>Desa</dt>
          <dd>{group?.village ?? item.groupId.toUpperCase()}</dd>
        </div>
        <div>
          <dt>Jam operasional</dt>
          <dd>{item.openingHours ?? 'Konfirmasi dengan pemilik'}</dd>
        </div>
        <div>
          <dt>Pemesanan</dt>
          <dd>{item.whatsapp ? 'WhatsApp tersedia' : 'Kontak belum dipublikasikan'}</dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="section profile-content">
    <div class="container detail-main">
      {
        isDummyProfile && (
          <InfoBox title="Data belum terverifikasi" tone="planned">
            Informasi bertanda [DUMMY] masih dipertahankan sebagai data contoh. Kontak sensitif
            tetap dikosongkan sampai data aman dan siap dipublikasikan.
          </InfoBox>
        )
      }

      <section class="detail-section product-section">
        <div class="detail-section__heading">
          <p class="eyebrow">Produk unggulan</p>
          <h2>Yang dapat ditemukan dari usaha ini.</h2>
          <p>
            Harga dan ketersediaan mengikuti informasi terakhir dari pemilik usaha. Konfirmasi
            kembali sebelum memesan.
          </p>
        </div>
        {
          products.length ? (
            <div class="product-grid">
              {products.map((product) => <ProductCard product={product} />)}
            </div>
          ) : (
            <InfoBox title="Produk belum tersedia">
              Data produk aktif yang terhubung dengan UMKM ini belum ditemukan.
            </InfoBox>
          )
        }
      </section>

      <QRCodeCard catalogUrl={item.catalogUrl} qrisImage={item.qrisImage} name={item.name} />

      <section class="detail-section story-section">
        <div class="detail-section__heading">
          <p class="eyebrow">Cerita usaha</p>
          <h2>Berangkat dari produk dan keseharian warga.</h2>
        </div>
        {
          storyParagraphs.length > 0 ? (
            <div class="prose">
              {storyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ) : (
            <>
              <p>{item.shortDescription}</p>
              <InfoBox title="Cerita usaha belum tersedia">
                Narasi panjang usaha belum dicantumkan pada Google Sheets.
              </InfoBox>
            </>
          )
        }
        {
          uniquenessParagraphs.length > 0 && (
            <div class="profile-narrative-block">
              <h3>Keunikan usaha</h3>
              <div class="prose">
                {uniquenessParagraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          )
        }
      </section>

      {galleryImages.length > 0 && <ImageGallery images={galleryImages} title="Galeri produk" />}

      <section class="detail-section" id="lokasi">
        <div class="detail-section__heading">
          <p class="eyebrow">Lokasi usaha</p>
          <h2>Datang atau cari alamatnya.</h2>
          <p>{item.address ?? 'Alamat lengkap belum dicantumkan.'}</p>
        </div>
        <MapEmbed embedUrl={item.mapsEmbed} address={item.address} label={item.name} />
      </section>

      <section class="detail-section assistance-section">
        <div class="detail-section__heading">
          <p class="eyebrow">Pendampingan KKN</p>
          <h2>Dukungan yang dicatat bersama usaha.</h2>
        </div>
        <ul class="assistance-list">
          {item.assistance.map((assistance) => <li>{assistance}</li>)}
        </ul>
        <p>
          Daftar ini menunjukkan bentuk pendampingan pada metadata, bukan bukti bahwa seluruh
          bantuan atau dampak sudah terealisasi.
        </p>
      </section>

      <AidSummary items={[]} title="Bantuan fisik yang terverifikasi" />

      <section class="detail-section impact-section">
        <div class="detail-section__heading">
          <p class="eyebrow">Dampak pendampingan</p>
          <h2>Perubahan yang sudah dapat dibuktikan.</h2>
        </div>
        {
          impactParagraphs.length > 0 ? (
            <div class="prose">
              {impactParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ) : (
            <InfoBox title="Data dampak belum tersedia">
              Dampak seperti peningkatan penjualan, jangkauan promosi, atau kualitas kemasan baru
              akan ditampilkan jika ada data realisasi yang dapat diverifikasi.
            </InfoBox>
          )
        }
      </section>

      <RelatedContent
        title="UMKM lain dari kelompok ini"
        items={related.map((relatedItem) => ({
          href: `/umkm/${relatedItem.groupId}/${relatedItem.slug}`,
          title: relatedItem.name,
          description: relatedItem.shortDescription,
          label: relatedItem.category,
        }))}
      />
    </div>
  </section>

  {
    item.whatsapp && (
      <div class="mobile-order-action" aria-label="Aksi pemesanan">
        <WhatsAppButton number={item.whatsapp} label={`Pesan di ${item.name}`} />
      </div>
    )
  }
</BaseLayout>

<style>
  .profile-header {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-5) clamp(var(--space-7), 8vw, var(--space-9));
    border-bottom: 1px solid rgb(203 198 184 / 58%);
    background:
      radial-gradient(circle at 88% 18%, rgb(124 185 232 / 22%), transparent 21rem),
      radial-gradient(circle at 6% 104%, rgb(232 154 183 / 9%), transparent 20rem),
      linear-gradient(180deg, rgb(255 255 255 / 68%), transparent);
  }

  .profile-header__grid {
    display: grid;
    margin-top: var(--space-6);
    align-items: center;
    gap: var(--space-7);
  }

  .profile-header__copy {
    display: grid;
    max-width: 44rem;
    justify-items: start;
    gap: var(--space-4);
  }

  .profile-header__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .profile-header__badges > span {
    padding: 0.22rem 0.62rem;
    border-radius: var(--radius-pill);
    color: var(--color-link);
    background: var(--color-primary-soft);
    font-size: var(--font-size-xs);
    font-weight: 800;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--font-size-3xl);
    letter-spacing: -0.04em;
  }

  .profile-header__tagline {
    color: var(--color-t2);
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-style: italic;
  }

  .profile-header__description {
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .profile-header__actions {
    display: flex;
    margin-top: var(--space-2);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .profile-header__location-action {
    display: inline-flex;
    min-height: 2.875rem;
    padding: 0.68rem 1rem;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-dark);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: 800;
    text-decoration: none;
  }

  .profile-header__location-action:hover {
    border-color: var(--color-primary-dark);
    color: var(--color-link);
    background: var(--color-primary-soft);
  }

  .profile-header__location-action svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .profile-header__media {
    position: relative;
    min-width: 0;
    margin: 0;
  }

  .profile-header__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0.45rem solid var(--color-surface);
    border-radius: 42% 58% 45% 55% / 56% 43% 57% 44%;
    object-fit: cover;
    background: var(--color-surface-soft);
    box-shadow: var(--shadow-lg);
  }

  .profile-header__media figcaption {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    padding: 0.42rem 0.7rem;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid rgb(255 255 255 / 48%);
    border-radius: var(--radius-pill);
    color: var(--color-surface);
    background: rgb(30 42 48 / 76%);
    font-size: 0.66rem;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  .profile-header__media figcaption span {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .profile-header__facts {
    display: grid;
    margin: var(--space-7) 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 70%);
    box-shadow: var(--shadow-sm);
  }

  .profile-header__facts div {
    display: grid;
    padding: var(--space-4);
    gap: var(--space-1);
  }

  .profile-header__facts div + div {
    border-top: 1px solid var(--color-border);
  }

  .profile-header__facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .profile-header__facts dd {
    margin: 0;
    color: var(--color-dark);
    font-weight: 750;
  }

  .profile-content {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 42%), transparent 30rem),
      var(--color-background);
  }

  .detail-section__heading {
    display: grid;
    max-width: 42rem;
    gap: var(--space-2);
  }

  .detail-section__heading > p:not(.eyebrow),
  .assistance-section > p {
    color: var(--color-text-muted);
  }

  .product-section {
    padding: clamp(var(--space-5), 6vw, var(--space-7));
    border: 1px solid rgb(79 143 190 / 20%);
    border-radius: var(--radius-lg);
    background: var(--color-primary-soft);
  }

  .product-grid {
    display: grid;
    gap: var(--space-4);
  }

  .story-section,
  .assistance-section,
  .impact-section {
    padding-block: var(--space-4);
  }

  .profile-narrative-block {
    display: grid;
    padding: var(--space-5);
    gap: var(--space-3);
    border-left: 3px solid var(--color-t1);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-t1-soft);
  }

  .profile-narrative-block h3 {
    font-size: var(--font-size-xl);
  }

  .assistance-list {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .assistance-list li {
    padding: 0.45rem 0.78rem;
    border: 1px solid rgb(85 107 47 / 16%);
    border-radius: var(--radius-pill);
    color: var(--color-t3-dark);
    background: var(--color-t3-soft);
    font-size: var(--font-size-sm);
    font-weight: 750;
  }

  .mobile-order-action {
    position: fixed;
    z-index: 45;
    right: var(--space-4);
    bottom: var(--space-4);
    left: var(--space-4);
    display: grid;
    padding: var(--space-2);
    place-items: center;
    border: 1px solid rgb(38 122 74 / 18%);
    border-radius: var(--radius-pill);
    background: rgb(250 249 245 / 92%);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(12px);
  }

  @media (min-width: 40rem) {
    .profile-header__facts,
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-header__facts div + div {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .profile-header__facts div:nth-child(3) {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .profile-header__facts div:nth-child(4) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (min-width: 64rem) {
    .profile-header__grid {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.85fr);
    }

    .profile-header__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .profile-header__facts div + div,
    .profile-header__facts div:nth-child(3),
    .profile-header__facts div:nth-child(4) {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mobile-order-action {
      display: none;
    }
  }
</style>
